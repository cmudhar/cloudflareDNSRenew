{
  "ipService": {
    "serviceUrl": "https://api.ipify.org?format=json",
    "name": "ipify"
  },
  "cloudflare": {
    "apiKey": "${CLOUDFLARE_API_KEY}",
    "email": "${CLOUDFLARE_EMAIL}",
    "zoneId": "${CLOUDFLARE_ZONE_ID}",
    "dnsRecords": [
      {
        "name": "${DNS_RECORD_NAME}",
        "type": "A",
        "proxied": false,
        "ttl": 300,
        "id": null
      }
    ]
  },
  "lastKnownIp": null,
  "logLevel": "info"
}
